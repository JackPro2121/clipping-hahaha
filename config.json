{
  "clipper": {
    "max_clips_per_video": 4,
    "min_segment_s": 15,
    "max_segment_s": 90,
    "scene_threshold": 0.3,
    "aspect": "vertical",
    "width": 1080,
    "height": 1920,
    "max_source_duration_s": 900
  },
  "motion": {
    "enabled": false,
    "zoom_factor": 1.1
  },
  "captions": {
    "enabled": true,
    "burn_in": true,
    "lang": "en"
  },
  "discovery": {
    "enabled": false,
    "strategy": "channel",
    "targets": [],
    "search_terms": [],
    "country": "US",
    "min_views": 100000,
    "max_duration_s": 600,
    "max_new_sources": 5
  },
  "buffer": {
    "caption_template": "{title} - clip {index}/{total} {hashtags}",
    "hashtags": "#shorts",
    "schedule_mode": "addToQueue",
    "max_posts_per_channel": 8,
    "services": []
  }
}