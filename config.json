{
  "clipper": {
    "max_clips_per_video": 3,
    "clip_length_s": 45,
    "transition_every_s": 4,
    "transition_duration_s": 0.15,
    "min_clip_s": 30,
    "scene_threshold": 0.3,
    "aspect": "vertical",
    "width": 1080,
    "height": 1920,
    "max_source_duration_s": 900
  },
  "motion": {
    "enabled": true,
    "type": "pan_rl",
    "zoom_factor": 1.1
  },
  "effects": {
    "enabled": true,
    "bgm": true,
    "bgm_volume": 0.35,
    "subtle_filter": "eq=contrast=1.05:saturation=1.12:brightness=0.015,vignette=angle=PI/7"
  },
  "captions": {
    "enabled": true,
    "burn_in": true,
    "lang": "en"
  },
  "discovery": {
    "enabled": true,
    "strategy": "bilibili",
    "targets": [],
    "search_terms": [],
    "upload_date": "week",
    "country": "US",
    "min_views": 10000,
    "max_duration_s": 900,
    "min_source_duration_s": 40,
    "max_new_sources": 3
  },
  "buffer": {
    "caption_template": "{title} - clip {index}/{total} {hashtags}",
    "hashtags": "#shorts",
    "schedule_mode": "addToQueue",
    "max_posts_per_channel": 8,
    "services": []
  }
}