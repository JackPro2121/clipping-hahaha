{
  "clipper": {
    "max_clips_per_video": 3,
    "clip_length_s": 45,
    "transition_every_s": 4,
    "transition_duration_s": 0.15,
    "min_clip_s": 30,
    "aspect": "vertical",
    "width": 1080,
    "height": 1920,
    "max_source_duration_s": 900
  },
  "motion": {
    "enabled": true,
    "zoom_factor": 1.12
  },
  "effects": {
    "enabled": true,
    "bgm": true,
    "bgm_volume": 0.35,
    "subtle_filter": "eq=contrast=1.05:saturation=1.12:brightness=0.015,vignette=angle=PI/7"
  },
  "brand": {
    "enabled": true,
    "name": "ZenCut",
    "handle": "@ZenCut",
    "logo_path": "zencut-icon-transparent.png",
    "position": "top_left",
    "logo_width": 85,
    "opacity": 0.9
  },
  "captions": {
    "enabled": true,
    "burn_in": true,
    "lang": "en",
    "translate_to_english": true,
    "fallback_mode": "title"
  },
  "discovery": {
    "enabled": true,
    "strategy": "bilibili",
    "categories": ["food", "tech", "travel", "knowledge", "music"],
    "min_quality_score": 20,
    "min_views": 50000,
    "max_duration_s": 900,
    "min_source_duration_s": 40,
    "max_new_sources": 3
  },
  "buffer": {
    "caption_template": "{title} {hashtags}",
    "hashtags": "#zencut #viral #fyp #satisfying #trending #reels",
    "max_posts_per_channel": 3,
    "max_queue_depth": 10,
    "services": ["tiktok"],
    "per_platform_captions": {
      "tiktok": "{title} \ud83c\udfac {hashtags}",
      "instagram": "{title} \ud83c\udfac Follow @zencut for daily satisfying clips! {hashtags}"
    }
  },
  "storage": {
    "auto_cleanup": true,
    "retention_days": 14
  }
}